# ─────────────────────────────────────────────
#  Findora AI — .gitignore
#  Keeps all personal/local data off GitHub.
# ─────────────────────────────────────────────

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Virtual Environments ──────────────────────
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
active_env/

# ── Logs ──────────────────────────────────────
*.log
pip-log.txt
pip-delete-this-directory.txt

# ── Tests / Coverage ──────────────────────────
htmlcov/
.tox/
.nosexyproject
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
cover/

# ── Environment / Secrets ─────────────────────
.env
.env.*
!.env.example

# ── IDE & Editor ──────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db

# ── PyInstaller ───────────────────────────────
*.manifest
*.spec

# ─────────────────────────────────────────────
#  PROJECT-SPECIFIC: Local data — NEVER upload
# ─────────────────────────────────────────────

# SQLite database (contains personal object-tracking history)
database/*.db
database/*.db-shm
database/*.db-wal

# Object crop snapshots (personal images captured from live cameras)
database/thumbnails/*.jpg
database/thumbnails/*.jpeg
database/thumbnails/*.png
database/thumbnails/*.webp

# YOLOv8 model weights (large binary — auto-downloaded on first run)
*.pt
*.pth
*.onnx
*.tflite

# ── Node / Frontend ───────────────────────────
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
